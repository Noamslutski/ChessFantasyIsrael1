<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ChessFantasyApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ChessFantasy">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.PackOpeningActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.AdActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.TradeOfferActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.CardDetailActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.SpinActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.LeaderboardActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.UpcomingGamesActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.TeamActivity"
            android:screenOrientation="portrait" />
    </application>

</manifest>
